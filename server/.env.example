# ─────────────────────────────────────────────────────────────
# DTI Pulse — server environment
# Copy to server/.env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Hostinger's Node.js app assigns the port. Leave PORT unset there so the
# platform-provided value is used; set it explicitly only for local runs.
PORT=5000

# Public URLs. CLIENT_URL is the CORS allow-list origin in production —
# if it is wrong, the browser will block every API call.
APP_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# ── Process timezone ──
# All attendance logic is IST-authoritative. Pinning TZ makes DATE column reads
# deterministic regardless of the host's system clock zone.
TZ=Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# ── MySQL ──
# Hostinger prefixes database and user names with your account id,
# e.g. u123456789_dtipulse. Copy them exactly from hPanel → Databases.
#
# DB_HOST: use "localhost" when the app runs on the same Hostinger server.
# For remote access from your machine, use the hostname hPanel shows under
# "Remote MySQL" and whitelist your public IP there first.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u000000000_dtipulse
DB_PASSWORD=
DB_NAME=u000000000_dtipulse
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ──
# MUST be at least 32 chars and unique to this deployment. The server refuses
# to boot in production if this is missing, short, or the default placeholder.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email / SMTP ──
# Required for OTP delivery. With no SMTP configured, OTP emails are skipped
# and — in production — the code is never logged, so nobody can verify or
# reset a password. Configure this before going live.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USER=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# ── App config ──
EMPLOYEE_ID_PREFIX=DTI

# ── OTP policy ──
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
